{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Start All (Next.js + MCP Server)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:all"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "serverReadyAction": {
        "pattern": "Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "▲ Next.js (Port 3000)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "serverReadyAction": {
        "pattern": "Local:.+(https?://localhost:3000)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "⚡ MCP Server (Port 3001)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "mcp:dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "🔥 Debug All (Parallel)",
      "configurations": ["▲ Next.js (Port 3000)", "⚡ MCP Server (Port 3001)"],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "1_debug",
        "order": 1
      }
    }
  ]
}
